# CareHub Patient Mobile Application - Environment Configuration
# IMPORTANT: When running the mobile app on a physical phone using Expo Go:
# Replace YOUR_COMPUTER_LAN_IP with your computer's local Wi-Fi / Ethernet IPv4 address (e.g. 192.168.1.44).
# Do NOT use 'localhost' or '127.0.0.1' because on a physical phone, 'localhost' refers to the phone itself.
#
# Examples:
# Physical Phone (Expo Go on same Wi-Fi network):
# EXPO_PUBLIC_API_URL=http://192.168.1.44:5000/api
#
# Android Studio Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
#
# Production / Deployed Backend:
# EXPO_PUBLIC_API_URL=https://api.carehub.yourdomain.com/api

EXPO_PUBLIC_API_URL=http://192.168.1.44:5000/api
